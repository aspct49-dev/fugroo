# Roobet affiliate stats API. Both values are issued with the affiliate account;
# the key is a bearer token, so it must never reach the browser.
ROOBET_API_KEY=
ROOBET_USER_ID=

# Canonical origin, e.g. https://fugroobets.com. Optional on Vercel, which
# supplies VERCEL_PROJECT_PRODUCTION_URL.
NEXT_PUBLIC_SITE_URL=

# Discord OAuth, from discord.com/developers/applications -> OAuth2. Register
# both callback URLs there:
#   http://localhost:3000/api/auth/callback/discord
#   https://<your-domain>/api/auth/callback/discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Google OAuth, from console.cloud.google.com -> APIs & Services ->
# Credentials -> OAuth client ID (Web application). Register both redirects:
#   http://localhost:3000/api/auth/callback/google
#   https://<your-domain>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Kick OAuth, from kick.com/settings/developer. Register the redirect exactly
# as <AUTH_URL>/api/kick/callback, and ask only for the user:read scope.
#
# Only used to let someone connect their Kick account on the Profile page, so a
# raffle entry typed in chat can be matched to their Roobet account. Leave both
# blank and the Connect button simply does not appear — everything else on the
# site works without it.
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=

# Where VIP transfer applications are delivered. Discord -> Server Settings ->
# Integrations -> Webhooks -> New Webhook, pointed at the channel that reviews
# them, then Copy Webhook URL.
#
# Applications are not stored anywhere: the form posts, the screenshots go to
# this webhook as attachments, and the request ends. Leave it blank and the
# page still renders but a submission returns an error rather than vanishing.
DISCORD_WEBHOOK_URL=

# Signs the session cookie. Generate with: openssl rand -base64 32
AUTH_SECRET=

# The origin people actually reach the site on. ALWAYS set this — locally it is
# http://localhost:3000, in production it is the real domain.
#
# It cannot be left to inference. Next builds request.url from its own binding:
# it honours x-forwarded-proto but ignores x-forwarded-host, so behind any proxy
# (nginx, a tunnel) it reports https://localhost:<port> even though the correct
# host header did arrive. Auth.js builds the OAuth callback from that, so an
# unpinned AUTH_URL sends people to localhost on their own machine, where
# nothing is listening. trustHost does not save you from this.
#
# Whatever this is set to must also be registered as a redirect on the Discord
# app, as <AUTH_URL>/api/auth/callback/discord.
AUTH_URL=http://localhost:3000

# Comma-separated Discord user ids with admin access. Preferred over the
# handle list in src/lib/admin.ts, because a handle can be changed or released
# and an id cannot.
ADMIN_DISCORD_IDS=

# Storage backend. Leave both unset and the site writes data/*.json on local
# disk, which is what a single process on a VPS wants and what it does by
# default.
#
# Set them — Vercel KV, or Upstash Redis, either sets these when you connect a
# store to the project — and the same tables move into that store instead.
# Serverless platforms have no writable disk outside /tmp, and /tmp is
# per-instance and wiped, so on Vercel this is not optional: without it every
# tournament, guess and linked Roobet account is lost on the next request.
#
# Vercel KV names them KV_REST_API_URL / KV_REST_API_TOKEN; a direct Upstash
# integration names them UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN.
# Either pair works.
KV_REST_API_URL=
KV_REST_API_TOKEN=
